# Copy this file to .env for local development. Values below are local-only
# examples; never put production or personal credentials in this repository.

COMPOSE_PROJECT_NAME=financial-pods
APP_ENV=development

WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=financial_pods
POSTGRES_USER=financial_pods
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://financial_pods:local-development-only@postgres:5432/financial_pods

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
